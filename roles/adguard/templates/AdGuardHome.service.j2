[Unit]
Description=AdGuard Home: Network-level blocker
After=network.target

[Service]
User={{ adguard_user }}
Group={{ adguard_group }}
WorkingDirectory={{ adguard_install_dir }}
# The binary lives outside the working directory, so name both explicitly.
ExecStart={{ adguard_binary }} --no-check-update -w {{ adguard_install_dir }} -c {{ adguard_config_file }} -s run
ExecStopPost=/bin/sleep 1
Restart=on-failure
RestartSec=5s
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_RAW

# Sandboxing. Only the working directory (config + data) is writable.
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths={{ adguard_install_dir }}
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
